# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=production
PORT=8787
DATABASE_URL=postgres://deck:change-me@db:5432/deck
# Public origin users load DECK from (used for CSRF/origin checks, cookies and email links)
DECK_PUBLIC_URL=https://deck.example.com
# Extra allowed origins, comma-separated (optional)
DECK_ALLOWED_ORIGINS=
# Serve the built web app from the API server
DECK_STATIC_DIR=/app/apps/web/dist
# Optional: HTTP endpoint that delivers email {to, subject, text} (password reset links)
DECK_MAIL_WEBHOOK=
# Optional AI assistant (server-side only; never exposed to browsers)
ANTHROPIC_API_KEY=
DECK_AI_MODEL=claude-opus-5-5
# Rate limits per IP per minute
DECK_AUTH_RATE=30
DECK_API_RATE=600
